{
  "name": "@omniseed/os",
  "version": "1.0.0-alpha.22",
  "description": "Per-company operating environment for OmniSeed.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeajijola/omniseedos.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": "./src/app.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "vercel-build": "node scripts/build-unified-runtime.mjs --vercel",
    "build:vercel": "node scripts/build-unified-runtime.mjs --vercel",
    "build:runtime": "node scripts/build-unified-runtime.mjs",
    "test": "node --test",
    "test:distribution": "node scripts/verify-distribution.mjs",
    "check": "npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@omniseed/engine": "1.0.0-alpha.12",
    "@omniseed/lily": "https://github.com/mikeajijola/omniseed-lily/archive/c3bd1d69f3f501e550b7950f0c27eb813ebe762e.tar.gz",
    "@omniseed/omniform": "1.0.0-alpha.5",
    "@omniseed/provider-github-reference": "https://github.com/mikeajijola/omniseed-provider-github/archive/0933832167dec08bba66f61fc83d5d9cc08317fb.tar.gz"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "public",
    "api",
    "runtime-assembly",
    "vercel.json",
    "README.md",
    "docs",
    "scripts"
  ]
}
